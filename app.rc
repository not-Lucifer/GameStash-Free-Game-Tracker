// Version resource for GameStash.
//
// An executable with an empty version resource shows as "Unknown publisher"
// in the SmartScreen prompt and is a known heuristic signal for AV engines.
// The version comes from version.h, the single source of truth.

#include <winver.h>
#include "resource.h"
#include "version.h"

// Application icon. Forward slashes so the RC preprocessor does not treat
// the separator as an escape; resolved relative to this .rc file.
IDI_APPICON ICON "assets/gamestash.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    GS_VERSION_MAJOR,GS_VERSION_MINOR,GS_VERSION_PATCH,0
 PRODUCTVERSION GS_VERSION_MAJOR,GS_VERSION_MINOR,GS_VERSION_PATCH,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS      VS_FF_DEBUG
#else
 FILEFLAGS      0x0L
#endif
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"   // US English, Unicode
        BEGIN
            VALUE "CompanyName",      "Aman Singh"
            VALUE "FileDescription",  "Game Stash - Free Game Tracker"
            VALUE "FileVersion",      GS_VERSION_STRING4
            VALUE "InternalName",     "GameStash"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Aman Singh. MIT License."
            VALUE "OriginalFilename", "GameStash.exe"
            VALUE "ProductName",      "Game Stash"
            VALUE "ProductVersion",   GS_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 0x04B0
    END
END
